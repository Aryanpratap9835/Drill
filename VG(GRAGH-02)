#include <bits/stdc++.h>
using namespace std;
vector<vector<int>>g;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    cin>>n;
    g.resize(n+1);
    for(int i=0;i<n-1;i++){
        int a,b;
        cin>>a>>b;
        g[a].push_back(b);
        g[b].push_back(a);
    }
    int maxi=0;
    for(int i=1;i<=n;i++){
        maxi=max(maxi,static_cast<int>(g[i].size()));
    }
    cout<<maxi+1<<"\n";
}
