#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n),b(n);
        for(int i=0;i<n;i++)cin>>a[i];
        for(int j=0;j<n;j++)cin>>b[j];
        vector<int>c(n);
        for(int i=0;i<n;i++){
            c[i]=a[i]-b[i];
        }
        int ans=0;
        sort(c.begin(),c.end());
        for(int i=0;i<n;i++){
            int it=upper_bound(c.begin(),c.end(),-c[i])-c.begin();
            it=max(it,i+1);
            ans+=n-it;
        }
        cout<<ans<<"\n";
    }

}
