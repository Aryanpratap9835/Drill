class Solution {
public:
  bool check(int mid,int target,vector<int>&nums){
    vector<int>prefix(nums.size()+1,0);
    for(int i=0;i<nums.size();i++){
        prefix[i+1]=prefix[i]+nums[i];
    }int ans=INT_MAX;
    int head=-1;int tail=0;
    while(tail<nums.size()){
        while(head+1<nums.size()&&prefix[head+1]-prefix[tail]<target){
            head++;
        }
        if(prefix[head+1]-prefix[tail]>=target){
            ans=min(ans,head-tail+1);
        }
        if(ans<=mid)return true;
        if(tail<=head){
            tail++;
        }
        else{
            tail++;
            head=tail-1;
        }
    }return false;

  }
    int minSubArrayLen(int target, vector<int>& nums) {
        int li=0;int hi=nums.size();
        int ans=0;
        while(li<=hi){
            int mid=li+(hi-li)/2;
            if(check(mid,target,nums)){
                ans=mid;
                hi=mid-1;
            }else{
                li=mid+1;
            }
        }
        return ans;
    }
};
