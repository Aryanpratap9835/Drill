class Solution {
public:
    vector<int> countTasks(vector<int>& tasks, vector<int>& shifts) {
        vector<int>cole;
        int n=tasks.size();
        vector<long long>prefix(n+1,0);
        for(int i=0;i<n;i++){
            prefix[i+1]=1LL*prefix[i]+tasks[i];
        }
        long long completed=0;
        for(int i=0;i<shifts.size();i++){
            long long it=upper_bound(prefix.begin(),prefix.end(),1LL*shifts[i]+completed)-prefix.begin();
            if(it==n+1){
                cole.push_back(0);
                completed=0;
            }else{
                completed+=shifts[i];
                cole.push_back(n+1-it);
            }
        }
        return cole;
    }
};
