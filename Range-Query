#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main() {
	// your code goes here
	int n;
	cin>>n;
	vector<int>ans(n);
	for(auto&it:ans)cin>>it;
	int q;
	cin>>q;
	map<int,vector<int>>mt;
	for(int i=0;i<n;i++){
	    mt[ans[i]].push_back(i+1);
	}
	 while(q--){
	     int l,r,x;
	     cin>>l>>r>>x;
	     int upper=upper_bound(mt[x].begin(),mt[x].end(),r)-mt[x].begin();
	     int lower=lower_bound(mt[x].begin(),mt[x].end(),l)-mt[x].begin();
	     cout<<upper-lower<<"\n";
	 }
	}
