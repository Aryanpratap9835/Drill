
#include <bits/stdc++.h>
using namespace std;

int n, k;
int arr[10101];
pair<int,int> dp[1001];

pair<int,int> rec(int i) {
    // Base case
    if (dp[i].first != -1) return dp[i];

    // Every element itself is a subsequence
    pair<int,int> ans = {1, 1};

    // Transition
    for (int j = 0; j < i; j++) {
        if (abs(arr[i] - arr[j]) >= k) {
            int len = rec(j).first + 1;
            int ways = rec(j).second;

            if (len > ans.first) {
                ans = {len, ways};
            }
            else if (len == ans.first) {
                ans.second += ways;
            }
        }
    }

    return dp[i] = ans;
}

void solve() {
    cin >> n >> k;

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    memset(dp, -1, sizeof(dp));

    pair<int,int> ans = {0, 0};

    for (int i = 0; i < n; i++) {
        auto curr = rec(i);

        if (curr.first > ans.first) {
            ans = curr;
        }
        else if (curr.first == ans.first) {
            ans.second += curr.second;
        }
    }

    cout << ans.first << " " << ans.second << "\n";
}

signed main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    solve();
}
