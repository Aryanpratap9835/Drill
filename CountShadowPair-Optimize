class Solution {
public:
    long long shadowPairs(vector<int>& nums) {
        vector<int>st;
        unordered_map<int,int>mpp;
        long long ans=0;
        for(int x:nums){
            while(!st.empty()&&st.back()>x){
                mpp[st.back()]--;
                st.pop_back();
            }
                ans+=st.size()-mpp[x];
                mpp[x]++;
                st.push_back(x);
            }

        return ans;
    }
};
