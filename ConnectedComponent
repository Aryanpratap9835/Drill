#include <bits/stdc++.h>
using namespace std;
using state=pair<int,int>;
vector<vector<int>>g;
vector<vector<int>>vis;
int t;
 int n,m;
vector<vector<state>>path;
bool isValid(int r,int c){
    return (r>=0&&c>=0&&r<n&&c<m&&g[r][c]!=1&&vis[r][c]!=1);
}
void bfs(state node,int cc){
    if(g[node.first][node.second]==1)return;
    queue<state>q;
    q.push(node);
    vis[node.first][node.second]=1;
    path[cc].push_back(node);
    while(!q.empty()){
        state it=q.front();
        q.pop();
        int dx[4]={-1,1,0,0};
        int dy[4]={0,0,1,-1};
                for(int i=0;i<4;i++){
                    int r=dx[i]+it.first;
                    int c=dy[i]+it.second;
                    if(isValid(r,c)){
                        path[cc].push_back({r,c});
                        vis[r][c]=1;
                        q.push({r,c});
                    }
                }
            }
        }
int main(){
    cin>>t;
    while(t--){
       
        cin>>n>>m;
        g.resize(n);
        vis.assign(n,vector<int>(m));
        for(int i=0;i<n;i++){
            g[i].resize(m);
            for(int j=0;j<m;j++){
                cin>>g[i][j];
            }
        }
        int cc=0;
        path.clear();
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            if(!vis[i][j]&&g[i][j]==0){
                path.push_back({});
              bfs({i,j},cc);
              cc++;
    }
}
    }
    vector<vector<int>>arr=g;
   for(int i=0;i<path.size();i++){
    if(path[i].size()>1){
        for(auto &it:path[i]){
            arr[it.first][it.second]=path[i].size();
        
        }
    }
   }
   for(int i=0;i<n;i++){
    for(int j=0;j<m;j++){
        cout<<arr[i][j]<<" ";
    }
    cout<<"\n";
   }

    }
}
