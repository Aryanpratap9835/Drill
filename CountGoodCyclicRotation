class Solution {
public:
    int countGoodRotations(vector<int>& nums) {
        long long first=0;long long second=0;
        int good=0;
        for(int i=0;i<nums.size()/2;i++){
            first+=nums[i];
            second+=nums[nums.size()-1-i];
        }
        for(int i=0;i<nums.size();i++){
            if(first>second)good++;
            first-=nums[i];
            second+=nums[i];
            first+=nums[(nums.size()/2 +i)%nums.size()];
            second-=nums[(nums.size()/2 +i)%nums.size()];
        }
        return good;
    }
};
