class Solution {
public:
    int countSpecialIntegers(vector<int>& nums) {
        
        unordered_map<int,vector<int>>pos;
        for(int i=0;i<nums.size();i++){
            pos[nums[i]].push_back(i);
        }
        int ans=0;
        for(auto x:pos){
            if(x.second.size()==3&&x.second[1]-x.second[0]==x.second[2]-x.second[1]){   ans++;
                
            }
        }
        return ans;
    }
};
