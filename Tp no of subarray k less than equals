#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main(){
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        vector<int>ans(n);
        for(auto &it:ans)cin>>it;
        int a=0;
        int head=-1;int tail=0;int sum=0;
        while(tail<n){
            while(head+1<n&&sum<=k){
                if(sum+ans[head+1]>k)break;
                sum+=ans[head+1];
                head++;
            }
            
          
            a+=(head-tail+1);
            if(tail<=head){
                sum-=ans[tail++];
            }else{
                tail++;
                head=tail-1;
            }
        }
    cout<<a<<"\n";
    }
}
