class Solution {
public:
    int countGoodRotations(vector<int>& nums) {
        int n=nums.size();
         int mid=n/2;
    long long first=0;long long second=0;
    for(int i=0;i<mid;i++){
        first+=nums[i];
        second+=nums[i+mid];
    }
    int good=0;
   
    for(int i=0;i<mid;i++){
        first=first-nums[i]+nums[mid+i];
        second=second-nums[mid+i]+nums[i];
        if(first>second)good++;
    }
    for(int i=0;i<mid;i++){
        int temp=nums[i];
        nums[i]=nums[mid+i];
        nums[mid+i]=temp;
    }
     first=0;second=0;
    for(int i=0;i<mid;i++){
        first+=nums[i];
        second+=nums[i+mid];
    }
    for(int i=0;i<mid;i++){
        first=first+nums[mid+i]-nums[i];
        second=second+nums[i]-nums[mid+i];
        if(first>second)good++;
    }return good;
    }
};
