#include <bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        vector<int>ans(n);
        for(int i=0;i<n;i++)cin>>ans[i];
        int cnt=0;int head=-1;int tail=0;
        int a=0;
        while(tail<n){
            while(head+1<n&&cnt+(ans[head+1]==0)<=k){
                if(ans[head+1]==0)cnt++;
                head++;
            }
            a=max(a,head-tail+1);
            if(tail<=head){
                if(ans[tail]==0){
                    cnt--;
                }
                tail++;
            }else{
                tail++;
                head=tail-1;
            }
        }
        cout<<a<<"\n";
    }
}
