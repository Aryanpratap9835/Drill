class Solution {
public:
    int countGroups(vector<int>& position, vector<int>& speed, int distance) {
        int grp=position.size();
        for(int i=position.size()-2;i>=0;i--){
            if(speed[i]>speed[i+1]||position[i+1]-position[i]<=distance){
                grp--;
                speed[i]=speed[i+1];
            }
        }return grp;
    }
};
