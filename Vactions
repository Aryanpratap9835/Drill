#include <bits/stdc++.h>
using namespace std;
int dp[100001][4];
int n;
vector<vector<int>>Happy;

int rec(int lvl,int prev){
    if(lvl==n)return 0;
    if(dp[lvl][prev]!=-1)return dp[lvl][prev];
    int ans=0;
    for(int i=0;i<3;i++){
        if(i!=prev){
          ans=max(ans,Happy[lvl][i]+rec(lvl+1,i));    
        }
    }
    return dp[lvl][prev]=ans;
}
int main() {
    cin>>n;
	Happy.assign(n,vector<int>(3,0));
	memset(dp,-1,sizeof(dp));
	for(int i=0;i<n;i++){
	    int a,b,c;
	    cin>>a>>b>>c;
	    Happy[i][0]=a;
	    Happy[i][1]=b;
	    Happy[i][2]=c;
	}
	cout<<rec(0,3)<<"\n";
}
