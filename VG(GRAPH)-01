#include <bits/stdc++.h>
using namespace std;
vector<vector<char>>g;
vector<vector<int>>vis;
int n,m;
int dir[4][2]={{1,0},{0,1},{-1,0},{0,-1}};
void dfs(int i,int j,int cc){
    if(g[i][j]=='#')return;
    for(auto &it:dir){
        int r=it[0]+i;
        int c=it[1]+j;
        if(r>=0&&c>=0&&r<n&&c<m&&g[r][c]=='.'&&vis[r][c]==0){
            vis[r][c]=1;
            dfs(r,c,cc);
        }
    }
}
int main(){
  cin>>n>>m;
  g.resize(n,vector<char>(m));
  vis.resize(n,vector<int>(m));
  for(int i=0;i<n;i++){
    for(int j=0;j<m;j++){
        cin>>g[i][j];
    }
  }int cc=0;
  for(int i=0;i<n;i++){
    for(int j=0;j<m;j++){
        if(g[i][j]!='#'&&vis[i][j]==0){
            cc++;
            dfs(i,j,cc);
        }
    }
  }
  cout<<cc<<"\n";
  
}
