#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main() {
	// your code goes here
	int n,a,b;
	cin>>n>>a>>b;
	string s;
	cin>>s;
	int tail=0;int head=-1;
	int ans=0;int Rmin=-1;
	int cntA=0;int cntB=0;
	vector<int>pos;
	for(int i=0;i<n;i++){
	    if(s[i]=='a')pos.push_back(i);
	}
	while(tail<n){
	    while(head+1<n&&cntB+(s[head+1]=='b')<b){
	        if(s[head+1]=='b')cntB++;
	        if(s[head+1]=='a')cntA++;
	        head++;
	    }
	    if(cntA>=a){
	        int before=lower_bound(pos.begin(), pos.end(),tail)-pos.begin();
	        Rmin=pos[before+a-1];
	        ans+=head-Rmin+1;
	    }
	    if(tail<=head){
	        if(s[tail]=='b')cntB--;
	        if(s[tail]=='a')cntA--;
	        tail++;
	    }else{
	        tail++;
	       head=tail-1;
	    }
	}
	cout<<ans<<"\n";
}
