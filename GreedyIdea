class Solution {
public:
    int maximumGap(string skill, string station) {
        vector<int>l(skill.size());
        vector<int>r(skill.size());
        int j=0;
        for(int i=0;i<station.size();i++){
            if(j==skill.size())break;
            if(skill[j]==station[i]){
                l[j]=i;
                j++;
            }
        }
        j=skill.size()-1;
        int n=station.size();
        for(int i=n-1;i>=0;i--){
            if(j==-1)break;
            if(skill[j]==station[i]){
                r[j]=i;
                j--;
            }
        }
        int maxi=0;
        for(int i=1;i<l.size();i++){
           maxi=max(maxi,r[i]-l[i-1]);
        }
        return maxi;
    }
    
};
