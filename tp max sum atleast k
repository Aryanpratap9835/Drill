int freq[10001];
int dist=0;
void add(int freq[],int x){
    if(freq[x]==0)dist++;
    freq[x]++;
}
void rem(int freq[],int x){
    freq[x]--;
    if(freq[x]==0)dist--;
}
int main() {
	// your code goes here
	int n,k;
	cin>>n>>k;
	vector<int>ans(n);
		vector<int>prefix(n+1,0);
	for(int i=0;i<n;i++){
	    cin>>ans[i];
	    prefix[i+1]=prefix[i]+ans[i];
	}

	
	int tail=0;int head=-1;
	int sum=0;
	while(tail<n){
	    while(head+1<n&&dist<k){
	        head++;
	        add(freq,ans[head]);
	    }
	    if(dist>=k){
	        for(int r=head;r<n;r++){
	            sum+=prefix[r+1]-prefix[tail];

	        }
	    }
	    if(tail<=head){
	        rem(freq,ans[tail]);
	        tail++;
	       
	    }else{
	        tail++;
	        head=tail-1;
	    }
	}
	cout<<sum<<"\n";
}
	
