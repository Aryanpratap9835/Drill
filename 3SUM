#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main(){
    int t;
    cin>>t;
    while(t--){
        int n,target;
        cin>>n>>target;
        vector<int>ans(n);
        for(auto&it:ans)cin>>it;
        int nas=LLONG_MAX;
        sort(ans.begin(),ans.end());
        for(int i=0;i<n-2;i++){
            int tail=i+1;int head=n-1;
            while(tail<head){
                int sum=ans[tail]+ans[head]+ans[i];
                nas=min(nas,abs(sum-target));
                if(sum>target)head--;
                else if(sum<target)tail++;
                else{
                    nas=0;
                    break;

                }
            }
            if(nas==0)break;
        }
        cout<<nas<<"\n";
    }
}
