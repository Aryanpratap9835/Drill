class Solution {
public:
    vector<vector<int>> cyclicShift(int n, vector<vector<int>>& grid, vector<int>& rowShift, vector<int>& colShift) {
        vector<vector<int>>arr(n,vector<int>(n)),ans(n,vector<int>(n));
        for(int i=0;i<n;i++){
            
            for(int j=0;j<n;j++){
                arr[i][(j-rowShift[i]+n)%n]=grid[i][j];
            }
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                ans[(j-colShift[i]+n)%n][i]=arr[j][i];
            }
        }
        return ans;
    }
};
