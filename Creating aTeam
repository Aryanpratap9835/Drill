#include <bits/stdc++.h>
using namespace std;
vector<int>vis;
vector<vector<int>>g;
vector<int>color;
bool isB=true;
bool bfs(int node){
    queue<int>q;
    q.push(node);
    while(!q.empty()){
       int curr=q.front();
        q.pop();
        vis[curr]=1;
    for(int  x:g[curr]){
        if(!vis[x]){
            q.push(x);
            vis[x]=1;
            color[x]=1-color[curr];
        }else if(color[x]==color[curr])return false;
    }
    }return true;
}
int main(){
    ios::sync_with_stdio(false);
    cin.ignore(nullptr);
    int n,m;
    cin>>n>>m;
    g.resize(n+1,vector<int>());
    vis.assign(n+1,0);
    color.assign(n+1,0);
    for(int i=0;i<m;i++){
        int a,b;
        cin>>a>>b;
        g[a].push_back(b);
        g[b].push_back(a);
    }
   
    for(int i=1;i<=n;i++){
    if(vis[i]==0){    
    isB=bfs(i);
    if(isB==false){cout<<"NO\n";
    return 0;
    }
    }
    }
    cout<<"YES\n";
}
