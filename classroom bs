#include <bits/stdc++.h>
using namespace std;
#define int long long
bool check(int mid,vector<int>&ans,int k){
    int cnt=1;
    int last=ans[0];
    for(int i=1;i<ans.size();i++){
        if(ans[i]-last>=mid){
            last=ans[i];
            cnt++;
            if(cnt>=k)return true;
        }
    }return false;

}
signed main(){
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        vector<int>ans(n);
        for(int i=0;i<n;i++)cin>>ans[i];
        sort(ans.begin(),ans.end());
        int li=0;int hi=ans[n-1]-ans[0];
        int a=0;
        while(li<=hi){
            int mid=li+(hi-li)/2;
            if(check(mid,ans,k)){
                a=mid;
                li=mid+1;
            }else{
                hi=mid-1;
            }
        }
        cout<<a<<"\n";
    }
}
