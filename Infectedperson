#include <bits/stdc++.h>
using namespace std;
int dx[4]={-1,0,1,0};
int dy[4]={0,1,0,-1};
bool valid(int n,int m,vector<vector<int>>&g,int r,int c,vector<vector<int>>&vis){
    return (r>=0&&c>=0&&r<n&&c<m&&g[r][c]!=0&&vis[r][c]!=1&&g[r][c]!=2);
}
signed main(){
    int n,m;
    cin>>n>>m;
    vector<vector<int>>g(n,vector<int>(m));
    queue<pair<int,int>>q;
    int cnt=0;
     vector<vector<int>>vis(n,vector<int>(m));
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin>>g[i][j];
            if(g[i][j]==1)cnt++;
            if(g[i][j]==2){q.push({i,j});};
        }
    }
    int t=0;
   
    while(!q.empty()){
        int sz=q.size();
        if(cnt==0)break;
       
        t++;
        while(sz--){
        pair<int,int>cur=q.front();
        q.pop();
        int x=cur.first;int y=cur.second;
        for(int i=0;i<4;i++){
            int r=dx[i]+x;
            int c=dy[i]+y;
            if(valid(n,m,g,r,c,vis)){
                vis[r][c]=1;
                cnt--;
                q.push({r,c});
            }
        }
    }
}
if(cnt!=0)cout<<-1<<"\n";
else cout<<t<<"\n";
 }
