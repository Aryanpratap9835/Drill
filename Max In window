#include <bits/stdc++.h>
using namespace std;
vector<int>answer(const vector<int>&arr,int n,int k){
    deque<int>dq;
    vector<int>ans;
    for(int head=0;head<k;head++){
        while(!dq.empty()&&dq.front()<=head-n){
            dq.pop_front();
        }
        while(!dq.empty()&&arr[dq.back()]<=arr[head]){
            dq.pop_back();
        }
        dq.push_back(head);
        if(head>=n-1){
            ans.push_back(arr[dq.front()]);
        }
    }
    return ans;
}
int main(){
    int t;
    cin>>t;
    while(t--){
        int k,n;
        cin>>k>>n;
        vector<int>arr(k);
        for(auto &it:arr)cin>>it;
        vector<int>ans=answer(arr,n,k);
        for(int x:ans)cout<<x<<" ";
        cout<<"\n";

    }
    return 0;
}
