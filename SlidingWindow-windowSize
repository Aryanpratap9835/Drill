#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	int n,k;
	cin>>n>>k;
	vector<int>a(n);
	for(auto &it:a){
	    cin>>it;
	}
	int tail=0;int head=-1;
	map<int,int>mpp;
	int cnt=0;
	while(tail<k){
	    while(head+1<n-k+tail+1){
	        head++;
	        mpp[a[head]]++;
	    }
	    if(mpp.size()==1)cnt++;
	    if(head>=tail){
	        mpp[a[tail]]--;
	        if(mpp[a[tail]]==0)mpp.erase(a[tail]);
	        tail++;
	    }else{
	        tail++;
	        head=tail-1;
	        mpp.clear();
	    }
	    }
	    cout<<cnt<<"\n";
	}
	
}
