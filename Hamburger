#include <bits/stdc++.h>
using namespace std;
#define int long long
signed main() {
	string t;
	cin>>t;
	int nb,ns,nc,pb,ps,pc;
	cin>>nb>>ns>>nc>>pb>>ps>>pc;
	int rubles;
	cin>>rubles;
	int b=0;int s=0;int c=0;
	for(char ch:t){
	    if(ch=='B')b++;
	    else if(ch=='S')s++;
	    else c++;
	}
	auto check=[&](int x){
	    int ta=max(0LL,b*x-nb);
	    int tb=max(0LL,s*x-ns);
	    int tc=max(0LL,c*x-nc);
	    int cost=ta*pb+tb*ps+tc*pc;
	    return cost<=rubles;
	};
	int ans=0;
	int li=0;int hi=1e13;
	while(li<=hi){
	    int mid=li+(hi-li)/2;
	    if(check(mid)){
	        ans=mid;
	        li=mid+1;
	    }else{
	        hi=mid-1;
	    }
	}
	cout<<ans<<"\n";

}
