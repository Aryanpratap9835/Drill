class Solution {
public:
    int countSpecialIntegers(vector<int>& nums) {
        unordered_map<int,vector<int>>mpp;
        for(int i=0;i<nums.size();i++){
            mpp[nums[i]].push_back(i);
        }
        int dist=0;
        for(auto &it:mpp){
            if(it.second.size()==1)dist++;
            else{
                bool flag=false;
                for(int i=0;i+1<it.second.size();i++){
                    if(it.second[i]+1==it.second[i+1]){
                      flag=true;
                }else{
                    flag=false;
                    break;
                }
            }
            if(flag==true)dist++;
        }
    }return dist;
    }
};
