#include <bits/stdc++.h>
using namespace std;

int  findf(const vector<int>&ans,int li,int hi,int k){
    while(li<=hi){
        int mid=li+(hi-li)/2;
        if(ans[mid]==k){
          return mid;
        }else if(ans[mid]>k)hi=mid-1;
        else li=mid+1;
    }return -1;
}
int findl(const vector<int>&ans,int li,int hi,int k){
    while(li<=hi){
        int mid=li+(hi-li)/2;
        if(ans[mid]==k){
            return mid;
        }else if(ans[mid]<k)hi=mid-1;
        else li=mid+1;
    }return -1;
}
