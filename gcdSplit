class Solution {
public:

    int maxValidSplits(vector<int>& nums) {
        int n=nums.size();
        vector<int>prefix(n);
        vector<int>suffix(n);
        prefix[0]=nums[0];
        suffix[n-1]=nums[n-1];
        for(int i=1;i<n;i++){
            prefix[i]=gcd(prefix[i-1],nums[i]);
            suffix[n-i-1]=gcd(suffix[n-i],nums[n-i-1]);
        }
        int cnt=0;
        for(int i=0;i+1<n;i++){
            if(prefix[i]==suffix[i+1])cnt++;
        }
        for(int k=0;k<n;k++){
            vector<int>ans;
            for(int j=0;j<n;j++){
                if(k!=j)ans.push_back(nums[j]);
            }
            int nas=0;
            prefix.clear();
            prefix.assign(n-1,0);
            suffix.clear();
            suffix.assign(n-1,0);
            prefix[0]=ans[0];
            suffix[n-2]=ans[n-2];
            for(int i=1;i<n-1;i++){
                prefix[i]=gcd(prefix[i-1],ans[i]);
                suffix[n-2-i]=gcd(suffix[n-i-1],ans[n-2-i]);
            }
            for(int i=0;i+2<n;i++){
                if(suffix[i+1]==prefix[i])nas++;
            }
            cnt=max(cnt,nas);
            ans.clear();
        }
        return cnt;
    }
};
