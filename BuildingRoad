#include <bits/stdc++.h>
using namespace std;
int n,m;
vector<vector<int>>g;
vector<int>vis;
void bfs(int node){
    queue<int>q;
    q.push(node);
    while(!q.empty()){
        int x=q.front();
        q.pop();
        vis[x]=1;
        for(auto it:g[x]){
            if(!vis[it]){
                vis[it]=1;
                q.push(it);
            }
        }
    }
}
int main(){
    cin>>n>>m;
    g.resize(n+1);
    vis.assign(n+1,0);
    for(int i=0;i<m;i++){
        int a,b;
        cin>>a>>b;
        g[a].push_back(b);
        g[b].push_back(a);
    }
    int cc=0;
    for(int i=1;i<=n;i++){
       if(!vis[i]){
        cc++;
        bfs(i);
       }
    }
    cout<<cc-1<<"\n";
}
