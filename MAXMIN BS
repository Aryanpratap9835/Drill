#include <bits/stdc++.h>
using namespace std;
#define int long long
bool check(vector<int>ans,int mid,int k){
    int need=0;
    for(int i=1;i<ans.size();i++){
        int gap=ans[i]-ans[i-1];
        need+=(gap-1)/mid;
        if(need>k)return false;
    }
    return true;
}
signed main(){
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        vector<int>ans(n);
        for(int i=0;i<n;i++)cin>>ans[i];
        int li=1;int hi=ans[n-1]-ans[0];
        int a=-1;
        while(li<=hi){
            int mid=li+(hi-li)/2;
            if(check(ans,mid,k)){
                a=mid;
                hi=mid-1;
            }else{
                li=mid+1;
            }
        }
        cout<<a<<"\n";
    }
}
