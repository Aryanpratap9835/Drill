class Solution {
public:
    int minOperations(string s) {
        int ans=INT_MAX;
        int n=s.size();
       
        for(int j=0;j<s.size();j++){
            int cost=j;
            for(int i=0;i<s.size()/2;i++){
                int a=(int)s[(i+j)%n];
                int b=(int)s[(n-i-1+j)%n];
                int diff=abs(a-b);
                cost+=min(diff,26-diff);
            }
            ans=min(ans,cost);
        }return ans;
    }
};
