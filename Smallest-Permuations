#include <bits/stdc++.h>
using namespace std;
int n,m;
vector<int>indegree;
vector<vector<int>>g;
vector<int>topo;
void kahn(int node){
    priority_queue<int,vector<int>,greater<int>>pq;
    for(int i=1;i<=n;i++){
        if(indegree[i]==0)pq.push(i);
    }
    while(!pq.empty()){
        int cur=pq.top();
        pq.pop();
        topo.push_back(cur);
        for(auto v:g[cur]){
            indegree[v]--;
            if(indegree[v]==0)pq.push(v);
        }

    }
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    cin>>n>>m;
    g.resize(n+1);
    indegree.assign(n,0);
    for(int i=1;i<=m;i++){
        int l,r;
        cin>>l>>r;
        g[l].push_back(r);
        indegree[r]++;
    }
    kahn(n);
    if(topo.size()!=n)cout<<-1<<" ";
    else {
        for(int x:topo)cout<<x<<" ";
    }
}
