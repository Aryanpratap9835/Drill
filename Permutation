#include <bits/stdc++.h>
using namespace std;
int sol[100];
int taken[100];
void rec(const vector<int>&arr,int lvl,int n){
   if(lvl==n){
       for(int i=0;i<n;i++)cout<<sol[i]<<" ";
       cout<<"\n";
       return;
   }
   for(int i=0;i<n;i++){
       if(taken[i]==0){
           sol[lvl]=arr[i];
           taken[i]=1;
           rec(arr,lvl+1,n);
           taken[i]=0;
           sol[lvl]=0;
       }
   }
}

int main() {
	// your code goes here
	int n;
	cin>>n;
	vector<int>arr(n);
	for(auto&it:arr)cin>>it;
	rec(arr,0,n);

}
