#include <bits/stdc++.h>
using namespace std;
void Kdistinct(const vector<int>&arr,int n,int k){
    vector<int>freq(10000001,0);
    int dist=0;
    int head=-1;int tail=0;
    long long ans=0;
    while(tail<n){
        while(head+1<n&&(dist+(freq[arr[head+1]]==0)<=k)){
            if(freq[arr[head+1]]==0)dist++;
            freq[arr[head+1]]++;
            head++;
        }
        ans+=head-tail+1;
        if(tail<=head){
            freq[arr[tail]]--;
            if(freq[arr[tail]]==0)dist--;
            tail++;
        }else{
            tail++;
            head=tail-1;
        }
    }cout<<ans<<"\n";
}
int main(){
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        vector<int>arr(n);
        for(auto&it:arr)cin>>it;
        Kdistinct(arr,n,k);
    }
}
