class Solution {
public:
    int minDays(int n) {
        vector<int>dp(n+1,1e9);
        dp[0]=0;
        for(int x=1;x<=n;x++){
            int k=1;
            while(k){
                int points=k*(k+1)/2;
                if(points>x)break;
                dp[x]=min(dp[x],dp[x-points]+k+1);
                k++;
            }
        }
        return dp[n]-1;
    }
};
